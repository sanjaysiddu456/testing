<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F3F3">

    <!-- Toolbar -->

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@android:color/white"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:padding="15dp"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="Back"
            android:clickable="true"
            android:focusable="true"
            app:tint="#222222" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:text="New follow-up"
            android:textColor="#171717"
            android:textSize="14sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- Note -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="@android:color/white"
        android:gravity="center"
        android:text="Note: Call less than 10 Seconds"
        android:textColor="#999999"
        android:textSize="11sp" />

    <!-- Form Content -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="16dp"
            android:paddingBottom="20dp">

            <!-- Remarks -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Remarks"
                android:textColor="#222222"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etRemarks"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_followup_input"
                android:gravity="top|start"
                android:hint="Enter Remarks"
                android:inputType="textCapSentences|textMultiLine"
                android:padding="10dp"
                android:textColor="#222222"
                android:textColorHint="#AAAAAA"
                android:textSize="11sp" />

            <!-- New Follow-up Heading -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="New Follow-up"
                android:textColor="#171717"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Follow-up Type -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Follow-up"
                android:textColor="#222222"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerFollowUpType"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_followup_input"
                android:paddingHorizontal="8dp"
                android:spinnerMode="dropdown" />

            <!-- Date and Time -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <!-- Date -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Date"
                        android:textColor="#222222"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/layoutDatePicker"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_followup_input"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvSelectedDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="--/--/----"
                            android:textColor="#999999"
                            android:textSize="11sp" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_my_calendar"
                            android:contentDescription="Select date"
                            app:tint="#333333" />

                    </LinearLayout>

                </LinearLayout>

                <View
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <!-- Time -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.65"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Time"
                        android:textColor="#222222"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/layoutTimePicker"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_followup_input"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/tvSelectedTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="00:00"
                            android:textColor="#999999"
                            android:textSize="11sp" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_lock_idle_alarm"
                            android:contentDescription="Select time"
                            app:tint="#333333" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Update Button -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@android:color/white"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp">

        <Button
            android:id="@+id/btnUpdateFollowUp"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:backgroundTint="#00345F"
            android:text="Update"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F3F3"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <!-- Customer Details Card -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="2dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Name and Certification -->

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingTop="10dp">

                    <TextView
                        android:id="@+id/tvCustomerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@id/tvCertified"
                        android:text="Rajesh"
                        android:textColor="#171717"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCertified"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="Certified"
                        android:textColor="#75B900"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </RelativeLayout>

                <!-- Mobile and Email -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:id="@+id/tvMobileNumber"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="+91 9087654321"
                        android:textColor="#777777"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/tvEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="rajesh@gmail.com"
                        android:textColor="#777777"
                        android:textSize="10sp" />

                </LinearLayout>

                <!-- Vehicle Information -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp">

                    <!-- Registration Name -->

                    <include
                        layout="@layout/item_enquiry_detail_row"
                        android:id="@+id/rowRegName" />

                    <!-- Registration Number -->

                    <include
                        layout="@layout/item_enquiry_detail_row"
                        android:id="@+id/rowRegNo" />

                    <!-- Maker -->

                    <include
                        layout="@layout/item_enquiry_detail_row"
                        android:id="@+id/rowMaker" />

                    <!-- Model -->

                    <include
                        layout="@layout/item_enquiry_detail_row"
                        android:id="@+id/rowModel" />

                    <!-- Car -->

                    <include
                        layout="@layout/item_enquiry_detail_row"
                        android:id="@+id/rowCar" />

                </LinearLayout>

                <!-- Callback Information -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="#F5F2F2"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="8dp"
                    android:layout_marginHorizontal="8dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Call Back In"
                        android:textColor="#222222"
                        android:textSize="10sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvCallBackIn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2days"
                        android:textColor="#222222"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="5dp"
                        android:text="•"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvCallBackDateTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="20 Aug, 10:30 AM"
                        android:textColor="#222222"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </LinearLayout>




                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_enquiry_actions">

                    <!-- Call Customer -->

                    <LinearLayout
                        android:id="@+id/btnCallCustomer"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@android:drawable/ic_menu_call"
                            android:contentDescription="Call customer"
                            android:tint="#333333" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Call Customer"
                            android:textColor="#222222"
                            android:textSize="10sp"
                            android:fontFamily="sans-serif-medium" />

                    </LinearLayout>

                    <!-- Vertical Divider -->

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#DDDDDD" />

                    <!-- Close Enquiry -->

                    <LinearLayout
                        android:id="@+id/btnCloseEnquiry"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@android:drawable/ic_menu_close_clear_cancel"
                            android:contentDescription="Close enquiry"
                            android:tint="#333333" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Close Enquiry"
                            android:textColor="#222222"
                            android:textSize="10sp"
                            android:fontFamily="sans-serif-medium" />

                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

        </androidx.cardview.widget.CardView>






        <!-- Follow-up History Title -->

        <TextView
            android:id="@+id/tvFollowUpHistoryTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:text="Follow-up History"
            android:textColor="#171717"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- New Follow-up Link: Visible when follow-ups exist -->

        <TextView
            android:id="@+id/tvNewFollowUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:drawableStart="@android:drawable/ic_input_add"
            android:drawablePadding="5dp"
            android:gravity="center"
            android:text="New Follow-up"
            android:textColor="#00345F"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />

        <!-- Follow-up History Card -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="2dp"
            app:cardElevation="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Loading -->

                <ProgressBar
                    android:id="@+id/progressFollowUps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <!-- Empty State -->

                <LinearLayout
                    android:id="@+id/layoutNoFollowUps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:padding="8dp"
                            android:src="@android:drawable/ic_menu_call"
                            android:background="@drawable/bg_followup_circle"
                            android:tint="#333333"
                            android:contentDescription="Call follow-up" />

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="5dp"
                            android:padding="8dp"
                            android:src="@android:drawable/ic_menu_agenda"
                            android:background="@drawable/bg_followup_circle"
                            android:tint="#333333"
                            android:contentDescription="Follow-up history" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="No Follow-ups"
                        android:textColor="#222222"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Create follow-up for enquiry"
                        android:textColor="#888888"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btnCreateFollowUp"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="10dp"
                        android:backgroundTint="#00345F"
                        android:text="+  Create Follow-up"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- Follow-up List -->

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvFollowUps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:visibility="gone" />

                <!-- Error State -->

                <LinearLayout
                    android:id="@+id/layoutFollowUpError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvFollowUpError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Unable to load follow-ups"
                        android:textColor="#666666"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnRetryFollowUps"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginTop="6dp"
                        android:text="Retry"
                        android:textAllCaps="false" />

                </LinearLayout>

            </FrameLayout>

        </androidx.cardview.widget.CardView>


    </LinearLayout>

</androidx.core.widget.NestedScrollView>
<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F3F3"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Toolbar -->

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@android:color/white"
            android:elevation="2dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:padding="14dp"
                android:src="@android:drawable/ic_media_previous"
                android:contentDescription="Back"
                android:tint="#222222" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:text="Stock Details"
                android:textColor="#171717"
                android:textSize="13sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <!-- Vehicle Image -->

        <ImageView
            android:id="@+id/ivStockDetailsImage"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:background="#EEEEEE"
            android:scaleType="centerCrop"
            android:contentDescription="Vehicle image" />

        <!-- Image Indicator -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:background="@android:color/white"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●  ●  ●  ●"
                android:textColor="#009FE3"
                android:textSize="8sp" />

        </LinearLayout>

        <!-- Stock Information Card -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="5dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="2dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- Name and Availability -->

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvDetailsCarName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@id/tvDetailsAvailability"
                        android:text="Creta"
                        android:textColor="#171717"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDetailsAvailability"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="In Stock"
                        android:textColor="#009FE3"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </RelativeLayout>

                <!-- Stock Number -->

                <TextView
                    android:id="@+id/tvDetailsStockNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MH-41 50987"
                    android:textColor="#777777"
                    android:textSize="10sp" />

                <!-- Stock Date -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_marginTop="8dp"
                    android:background="#F5F3F3"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvStockDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="In stock from 20 Aug, 2026"
                        android:textColor="#222222"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Enquiry List Heading -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:text="Enquiry list"
            android:textColor="#171717"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Enquiry List -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvStockEnquiries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <!-- Empty State -->

        <LinearLayout
            android:id="@+id/layoutNoEnquiries"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginHorizontal="8dp"
            android:background="@android:color/white"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No enquiries available"
                android:textColor="#888888"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="7dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="2dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="9dp">

        <!-- Customer Name and Certification -->

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvEnquiryCustomerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/tvEnquiryCertified"
                android:text="Rajesh"
                android:textColor="#171717"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEnquiryCertified"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="Certified"
                android:textColor="#75B900"
                android:textSize="10sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <!-- Mobile Number -->

        <TextView
            android:id="@+id/tvEnquiryMobile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="+91 9087654321"
            android:textColor="#777777"
            android:textSize="9sp" />

        <!-- Last Enquired On -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="8dp"
            android:background="#F5F3F3"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="7dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Last enquired on"
                android:textColor="#222222"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/tvLastEnquiredDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20th Aug 2026"
                android:textColor="#222222"
                android:textSize="9sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>

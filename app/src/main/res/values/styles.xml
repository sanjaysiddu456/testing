<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="SellingLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">9dp</item>
        <item name="android:textColor">@color/selling_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SellingEditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:background">@drawable/bg_selling_input</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textColor">@color/selling_text</item>
        <item name="android:textColorHint">@color/selling_hint</item>
        <item name="android:textSize">11sp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="SellingSpinner">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:background">@drawable/bg_selling_input</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:spinnerMode">dropdown</item>
    </style>

    <style name="SellingButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:backgroundTint">@color/selling_navy</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

</resources>